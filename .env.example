# Environment Configuration for CareerPrep AI
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=careerprep_dev_secret_key_change_in_production_2026

# AI Configuration (Optional: Leave blank to use Demo Mode)
# Get a free Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Set to True to force Demo Mode, or False to use API when available
DEMO_MODE=False

# Database
DATABASE_URL=sqlite:///careerprep.db
